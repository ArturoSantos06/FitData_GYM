rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
          return isAuthenticated() && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
            request.auth.token.email == 'admin@fitdata.gym' ||
            request.auth.uid == '1'
          );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function belongsToUser(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    function ownsMember(memberId) {
      return isAuthenticated() &&
             memberId != null &&
             exists(/databases/$(database)/documents/miembros/$(memberId)) &&
             (
               get(/databases/$(database)/documents/miembros/$(memberId)).data.userId == request.auth.uid ||
               get(/databases/$(database)/documents/miembros/$(memberId)).data.authUid == request.auth.uid
             );
    }

    // Users Collection - Restrict access to own data or admins
    match /users/{userId} {
      allow read: if isOwner(userId) ||
                  (isAuthenticated() && (
                    resource.data.authUid == request.auth.uid ||
                    resource.data.email == request.auth.token.email
                  )) ||
                  isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin() || (isAuthenticated() && (resource.data.authUid == request.auth.uid || resource.data.email == request.auth.token.email));
      allow delete: if isAdmin();
    }

    // Members Collection - Linked to users
    match /miembros/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isAuthenticated();
      allow update: if isAdmin() || belongsToUser(resource.data.userId) || (isAuthenticated() && resource.data.authUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Appointments (Nutri) - authenticated users
    match /citas/{citaId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAuthenticated() || isAdmin();
    }

    // Membership Types - Public read for authenticated users
    match /membershipTypes/{typeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Memberships - User can see own, admin can see all
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        request.auth.uid == resource.data.authUid ||
        request.auth.token.email == resource.data.userEmail ||
        isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && (request.auth.uid == resource.data.authUid || request.auth.token.email == resource.data.userEmail));
      allow delete: if isAdmin();
    }

    // Products - Public read for authenticated users
    match /productos/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Attendance Records - Own records + admin
    match /asistencias/{recordId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAdmin()
      );
      allow create: if isAdmin() || isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Sales Records - Own records + admin
    match /ventas/{saleId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.cliente_auth_uid ||
        request.auth.uid == resource.data.cliente ||
        request.auth.uid == resource.data.cliente_id ||
        request.auth.uid == resource.data.userId ||
        (resource.data.cliente_id != null &&
         exists(/databases/$(database)/documents/users/$(resource.data.cliente_id)) &&
         get(/databases/$(database)/documents/users/$(resource.data.cliente_id)).data.authUid == request.auth.uid) ||
        (resource.data.cliente != null &&
         exists(/databases/$(database)/documents/users/$(resource.data.cliente)) &&
         get(/databases/$(database)/documents/users/$(resource.data.cliente)).data.authUid == request.auth.uid) ||
        request.auth.token.email == resource.data.cliente_email ||
        request.auth.token.email == resource.data.clienteEmail ||
        request.auth.token.email == resource.data.email ||
        isAdmin()
      );
      allow create: if isAdmin() || isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Inventory Entries - Admin only (internal operations)
    match /inventario_entradas/{entryId} {
      allow read: if isAdmin() || isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Health Profiles - Own records + admin
    match /healthProfiles/{profileId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || ownsMember(resource.data.memberId) || isAdmin()
      );
      allow create: if isAdmin() || (
        isAuthenticated() && (
          request.resource.data.userId == request.auth.uid ||
          ownsMember(request.resource.data.memberId)
        )
      );
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          ownsMember(resource.data.memberId) ||
          request.resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    // Trainer Notes - Private notes only accessible by admin/trainers
    match /trainerNotes/{noteId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    function isRoutineTrainer(data) {
      return isAuthenticated() && (
        request.auth.uid == data.ownerUid ||
        request.auth.uid == data.createdBy ||
        request.auth.token.email == data.trainerEmail
      );
    }

    function isRoutineMember(data) {
      return isAuthenticated() && (
        request.auth.uid == data.memberAuthUid ||
        request.auth.uid == data.memberUserId ||
        request.auth.token.email == data.memberEmail ||
        ownsMember(data.memberId)
      );
    }

    function canReadRoutine(data) {
      return isAdmin() || isRoutineTrainer(data) || isRoutineMember(data);
    }

    // Trainer routines - owner trainer, related member, or admin
    match /trainerRoutines/{routineId} {
      allow read: if canReadRoutine(resource.data);
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isRoutineTrainer(request.resource.data)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isRoutineTrainer(resource.data) ||
        isRoutineTrainer(request.resource.data)
      );
      allow delete: if isAuthenticated() && (isAdmin() || isRoutineTrainer(resource.data));
    }

    // Member routines mirror trainer routines for client access
    match /memberRoutines/{memberId} {
      allow read: if canReadRoutine(resource.data);
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isRoutineTrainer(request.resource.data)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isRoutineTrainer(resource.data) ||
        isRoutineTrainer(request.resource.data)
      );
      allow delete: if isAuthenticated() && (isAdmin() || isRoutineTrainer(resource.data));
    }

    function isValidDietFileTextField(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidDietFilePayload(data) {
      return isValidDietFileTextField(data, 'title', 120) &&
             isValidDietFileTextField(data, 'notes', 500);
    }

    // Diet Files - Private patient record files for admin management
    match /dietFiles/{fileId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidDietFilePayload(request.resource.data);
      allow update: if isAdmin() && isValidDietFilePayload(request.resource.data);
      allow delete: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}