rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function maxDietFileSize() {
      return 10 * 1024 * 1024;
    }
    
    // Función helper para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función helper para verificar si el usuario es admin
    function isAdmin() {
      return isAuthenticated() && 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Permitir lectura pública de todas las imágenes
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Productos - solo admin puede escribir
    match /productos/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Membresías - solo admin puede escribir
    match /memberships/{membershipId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Avatares - el usuario o admin pueden escribir
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Repositorio digital de dietas - solo admin puede leer y escribir
    match /dietas/{memberId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() &&
        request.resource != null &&
        request.resource.size <= maxDietFileSize() &&
        request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }
  }
}
