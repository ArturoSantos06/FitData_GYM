rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN'
      );
    }

    // Necesario para validar rol en EntrenadorLogin y listar alumnos en VistaEntrenador.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /miembros/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /trainerRoutines/{routineId} {
      allow read, write: if isSignedIn();
    }

    match /memberRoutines/{memberId} {
      allow read, write: if isSignedIn();
    }
  }
}
