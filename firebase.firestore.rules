rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN'
      );
    }

    function ownsMember(memberId) {
      return isSignedIn() &&
        memberId is string &&
        exists(/databases/$(database)/documents/miembros/$(memberId)) && (
          get(/databases/$(database)/documents/miembros/$(memberId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/miembros/$(memberId)).data.authUid == request.auth.uid
        );
    }

    // Necesario para validar rol en EntrenadorLogin y listar alumnos en VistaEntrenador.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /miembros/{memberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /trainerRoutines/{routineId} {
      allow read, write: if isSignedIn();
    }

    match /memberRoutines/{memberId} {
      allow read, write: if isSignedIn();
    }

    match /dietFiles/{fileId} {
      allow read: if isAdmin() || ownsMember(resource.data.memberId);
      allow write: if isAdmin();
    }
  }
}
