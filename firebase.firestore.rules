rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers base
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return isAuthenticated();
    }

    function userDocExists() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRoleIs(roleValue) {
      return userDocExists() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleValue
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'admin' ||
        userRoleIs('admin') ||
        userRoleIs('ADMIN')
      );
    }

    function isTrainer() {
      return isAuthenticated() && (
        request.auth.token.trainer == true ||
        request.auth.token.role == 'ENTRENADOR' ||
        request.auth.token.role == 'TRAINER' ||
        request.auth.token.role == 'entrenador' ||
        request.auth.token.role == 'trainer' ||
        userRoleIs('entrenador') ||
        userRoleIs('trainer') ||
        userRoleIs('ENTRENADOR') ||
        userRoleIs('TRAINER')
      );
    }

    function isNutritionist() {
      return isAuthenticated() && (
        request.auth.token.nutriologo == true ||
        request.auth.token.role == 'NUTRIOLOGO' ||
        request.auth.token.role == 'nutriologo' ||
        request.auth.token.role == 'NUTRI' ||
        request.auth.token.role == 'nutri' ||
        userRoleIs('nutriologo') ||
        userRoleIs('nutri') ||
        userRoleIs('NUTRIOLOGO') ||
        userRoleIs('NUTRI')
      );
    }

    function isPrivilegedStaff() {
      return isAdmin() || isTrainer() || isNutritionist();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function belongsToUser(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    function ownsMember(memberId) {
      return isAuthenticated() &&
             memberId != null &&
             exists(/databases/$(database)/documents/miembros/$(memberId)) &&
             (
               get(/databases/$(database)/documents/miembros/$(memberId)).data.userId == request.auth.uid ||
               get(/databases/$(database)/documents/miembros/$(memberId)).data.authUid == request.auth.uid
             );
    }

    function ownsUserDocument(data) {
      return isAuthenticated() && (
        (('authUid' in data) && data.authUid == request.auth.uid) ||
        (('email' in data) && data.email == request.auth.token.email)
      );
    }

    function ownsHealthProfileData(data) {
      return isAuthenticated() && (
        (('authUid' in data) && data.authUid == request.auth.uid) ||
        (('userId' in data) && data.userId == request.auth.uid) ||
        (('memberId' in data) && ownsMember(data.memberId)) ||
        (('email' in data) && data.email == request.auth.token.email)
      );
    }

    function canReadMember(data) {
      return isPrivilegedStaff() ||
             (isAuthenticated() && (
               (('authUid' in data) && data.authUid == request.auth.uid) ||
               (('userId' in data) && data.userId == request.auth.uid) ||
               (('email' in data) && data.email == request.auth.token.email)
             ));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) ||
                  ownsUserDocument(resource.data) ||
                  isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) ||
                    isAdmin() ||
                    ownsUserDocument(resource.data);
      allow delete: if isAdmin();
    }

    // Members collection
    match /miembros/{memberId} {
      allow read: if canReadMember(resource.data);
      allow create: if isAdmin() ||
                    (isAuthenticated() &&
                      (request.resource.data.authUid == request.auth.uid ||
                       request.resource.data.userId == request.auth.uid));
      allow update: if isPrivilegedStaff() ||
                    belongsToUser(resource.data.userId) ||
                    (isAuthenticated() && resource.data.authUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Membership types
    match /membershipTypes/{typeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Memberships
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        request.auth.uid == resource.data.authUid ||
        request.auth.token.email == resource.data.userEmail ||
        isPrivilegedStaff()
      );
      allow create: if isAdmin();
      allow update: if isPrivilegedStaff() ||
                    (isAuthenticated() && (
                      request.auth.uid == resource.data.authUid ||
                      request.auth.token.email == resource.data.userEmail
                    ));
      allow delete: if isAdmin();
    }

    // Products
    match /productos/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Attendance records
    match /asistencias/{recordId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || isPrivilegedStaff()
      );
      allow create: if isPrivilegedStaff() ||
                    (isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid);
      allow update: if isPrivilegedStaff() ||
                    (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Sales records
    match /ventas/{saleId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.cliente_auth_uid ||
        request.auth.uid == resource.data.cliente ||
        request.auth.uid == resource.data.cliente_id ||
        request.auth.uid == resource.data.userId ||
        (resource.data.cliente_id != null &&
         exists(/databases/$(database)/documents/users/$(resource.data.cliente_id)) &&
         get(/databases/$(database)/documents/users/$(resource.data.cliente_id)).data.authUid == request.auth.uid) ||
        (resource.data.cliente != null &&
         exists(/databases/$(database)/documents/users/$(resource.data.cliente)) &&
         get(/databases/$(database)/documents/users/$(resource.data.cliente)).data.authUid == request.auth.uid) ||
        request.auth.token.email == resource.data.cliente_email ||
        request.auth.token.email == resource.data.clienteEmail ||
        request.auth.token.email == resource.data.email ||
        isPrivilegedStaff()
      );
      allow create: if isPrivilegedStaff();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Inventory entries
    match /inventario_entradas/{entryId} {
      allow read: if isPrivilegedStaff();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Health profiles
    match /healthProfiles/{profileId} {
      allow read: if isPrivilegedStaff() || ownsHealthProfileData(resource.data);
      allow create: if isPrivilegedStaff() || ownsHealthProfileData(request.resource.data);
      allow update: if isPrivilegedStaff() || ownsHealthProfileData(resource.data);
      allow delete: if isAdmin();
    }

    // Trainer routines
    match /trainerRoutines/{routineId} {
      allow read: if isPrivilegedStaff() ||
                  ownsMember(resource.data.memberId) ||
                  (isAuthenticated() &&
                    (resource.data.memberAuthUid == request.auth.uid ||
                     resource.data.ownerUid == request.auth.uid));
      allow create, update: if isPrivilegedStaff();
      allow delete: if isAdmin() ||
                    (isPrivilegedStaff() && resource.data.ownerUid == request.auth.uid);
    }

    match /memberRoutines/{memberId} {
      allow read: if isPrivilegedStaff() || ownsMember(memberId);
      allow create, update: if isPrivilegedStaff();
      allow delete: if isAdmin();
    }

    // Sesiones de entrenamiento
    match /entrenamientos/{entryId} {
      allow read: if isPrivilegedStaff() || ownsMember(resource.data.memberId);
      allow create: if isAdmin() || isTrainer();
      allow update: if isAdmin() || (isTrainer() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() || (isTrainer() && resource.data.createdBy == request.auth.uid);
    }

    // Citas de nutricion
    match /citas/{citaId} {
      allow read: if isPrivilegedStaff() || ownsMember(resource.data.memberId);
      allow create: if isAdmin() || isNutritionist();
      allow update: if isAdmin() || (isNutritionist() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() || (isNutritionist() && resource.data.createdBy == request.auth.uid);
    }

    // Notas privadas del entrenador
    match /trainerNotes/{noteId} {
      allow read: if isAdmin() || (isTrainer() && resource.data.createdBy == request.auth.uid);
      allow create: if isTrainer() || isAdmin();
      allow update: if isAdmin() || (isTrainer() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() || (isTrainer() && resource.data.createdBy == request.auth.uid);
    }

    function isValidDietFileTextField(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidDietFilePayload(data) {
      return isValidDietFileTextField(data, 'title', 120) &&
             isValidDietFileTextField(data, 'notes', 500);
    }

    // Archivos de dieta (metadata)
    match /dietFiles/{fileId} {
      allow read: if isPrivilegedStaff() || ownsMember(resource.data.memberId);
      allow create: if
        (isPrivilegedStaff() ||
         ownsMember(request.resource.data.memberId) ||
         (isSignedIn() && request.resource.data.ownerUid == request.auth.uid)) &&
        isValidDietFilePayload(request.resource.data);
      allow update: if
        (isPrivilegedStaff() ||
          ownsMember(resource.data.memberId) ||
          (isSignedIn() &&
            (("ownerUid" in resource.data && resource.data.ownerUid == request.auth.uid) ||
             !("ownerUid" in resource.data)))) &&
        isValidDietFilePayload(request.resource.data);
      allow delete: if isPrivilegedStaff() ||
        ownsMember(resource.data.memberId) ||
        (isSignedIn() &&
          (("ownerUid" in resource.data && resource.data.ownerUid == request.auth.uid) ||
           !("ownerUid" in resource.data)));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
