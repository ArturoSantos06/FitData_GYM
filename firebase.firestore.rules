rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return isAuthenticated();
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
        request.auth.token.email == 'admin@fitdata.gym' ||
        request.auth.uid == '1'
      );
    }

    function isNutritionist() {
      return isAuthenticated() && (
        request.auth.token.nutriologo == true ||
        request.auth.token.nutritionist == true ||
        request.auth.token.role == 'NUTRIOLOGO' ||
        request.auth.token.role == 'nutriologo' ||
        request.auth.token.role == 'NUTRITIONIST' ||
        request.auth.token.role == 'nutritionist' ||
        request.auth.token.role == 'NUTRI' ||
        request.auth.token.role == 'nutri' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nutriologo' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nutriologa' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nutricionista' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nutritionist' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nutri'
      );
    }

    function isTrainer() {
      return isAuthenticated() && (
        request.auth.token.trainer == true ||
        request.auth.token.role == 'ENTRENADOR' ||
        request.auth.token.role == 'entrenador' ||
        request.auth.token.role == 'TRAINER' ||
        request.auth.token.role == 'trainer' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'entrenador' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
      );
    }

    function trainerMatchesAssignment(clientId) {
      return isTrainer() &&
             clientId != null &&
             exists(/databases/$(database)/documents/client_trainer_assignments/$(clientId)) &&
             (
               get(/databases/$(database)/documents/client_trainer_assignments/$(clientId)).data.trainerId == request.auth.uid ||
               get(/databases/$(database)/documents/client_trainer_assignments/$(clientId)).data.trainer_id == request.auth.uid ||
               get(/databases/$(database)/documents/client_trainer_assignments/$(clientId)).data.trainerEmail == request.auth.token.email ||
               get(/databases/$(database)/documents/client_trainer_assignments/$(clientId)).data.trainer_email == request.auth.token.email
             );
    }

    function isAssignedTrainerForMember(memberId) {
      return isTrainer() &&
             memberId != null &&
             exists(/databases/$(database)/documents/miembros/$(memberId)) &&
             (
               trainerMatchesAssignment(memberId) ||
               trainerMatchesAssignment(get(/databases/$(database)/documents/miembros/$(memberId)).data.userId) ||
               trainerMatchesAssignment(get(/databases/$(database)/documents/miembros/$(memberId)).data.authUid)
             );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function belongsToUser(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    function ownsMember(memberId) {
      return isAuthenticated() &&
             memberId != null &&
             exists(/databases/$(database)/documents/miembros/$(memberId)) &&
             (
               get(/databases/$(database)/documents/miembros/$(memberId)).data.userId == request.auth.uid ||
               get(/databases/$(database)/documents/miembros/$(memberId)).data.authUid == request.auth.uid
             );
    }

    function isRoutineTrainer(data) {
      return isSignedIn() && (
        request.auth.uid == data.ownerUid ||
        request.auth.uid == data.createdBy ||
        request.auth.token.email == data.trainerEmail
      );
    }

    function isRoutineMember(data) {
      return isSignedIn() && (
        request.auth.uid == data.memberAuthUid ||
        request.auth.uid == data.memberUserId ||
        request.auth.token.email == data.memberEmail ||
        ownsMember(data.memberId)
      );
    }

    function canReadRoutine(data) {
      return isAdmin() || isRoutineTrainer(data) || isRoutineMember(data);
    }

    // Users Collection - Restrict access to own data or admins
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) ||
                    isAdmin() ||
                    (isAuthenticated() && (
                      resource.data.authUid == request.auth.uid ||
                      resource.data.email == request.auth.token.email
                    )) ||
                    (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['selectedEntrenador'])) ||
                    (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gymPoints']));
      allow delete: if isAdmin();

      // Notificaciones de usuario
      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Members Collection - Linked to users
    match /miembros/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isAuthenticated();
      allow update: if isAdmin() ||
                    belongsToUser(resource.data.userId) ||
                    (isAuthenticated() && resource.data.authUid == request.auth.uid) ||
                    (isAssignedTrainerForMember(memberId) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivado', 'eliminado']));
      allow delete: if isAdmin();
    }

    // Membership Types - Public read for authenticated users
    match /membershipTypes/{typeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Memberships - User can see own, admin can see all
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        request.auth.uid == resource.data.authUid ||
        request.auth.token.email == resource.data.userEmail ||
        isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                    (isAuthenticated() && (
                      request.auth.uid == resource.data.authUid ||
                      request.auth.token.email == resource.data.userEmail
                    ));
      allow delete: if isAdmin();
    }

    // Products - Public read for authenticated users
    match /productos/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Attendance Records - Own records + admin
    match /asistencias/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Sales Records - Own records + admin
    match /ventas/{saleId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.cliente_auth_uid ||
        request.auth.uid == resource.data.cliente ||
        request.auth.uid == resource.data.cliente_id ||
        request.auth.uid == resource.data.userId ||
        (resource.data.cliente_id != null &&
         exists(/databases/$(database)/documents/users/$(resource.data.cliente_id)) &&
         get(/databases/$(database)/documents/users/$(resource.data.cliente_id)).data.authUid == request.auth.uid) ||
        (resource.data.cliente != null &&
         exists(/databases/$(database)/documents/users/$(resource.data.cliente)) &&
         get(/databases/$(database)/documents/users/$(resource.data.cliente)).data.authUid == request.auth.uid) ||
        request.auth.token.email == resource.data.cliente_email ||
        request.auth.token.email == resource.data.clienteEmail ||
        request.auth.token.email == resource.data.email ||
        (
          isTrainer() &&
          (resource.data.tipo_venta == 'SERVICIO_ENTRENAMIENTO' || resource.data.tipoVenta == 'SERVICIO_ENTRENAMIENTO')
        ) ||
        isAdmin()
      );
      allow create: if isAdmin() || isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Pagos a entrenadores 
    match /pagos_entrenadores/{paymentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == resource.data.trainer_id ||
        request.auth.token.email == resource.data.trainer_email
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Solicitudes de factura (cliente crea, admin gestiona)
    match /facturaRequests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.requesterUid == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.ventaId is string;
      allow update, delete: if isAdmin();
    }

    // Inventory Entries - Admin only (internal operations)
    match /inventario_entradas/{entryId} {
      allow read: if isAdmin() || isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Health Profiles - Own records + admin
    match /healthProfiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Trainer routines
    match /trainerRoutines/{routineId} {
      allow read: if canReadRoutine(resource.data);
      allow create: if isSignedIn() && (isAdmin() || isRoutineTrainer(request.resource.data));
      allow update: if isSignedIn() && (
        isAdmin() ||
        isRoutineTrainer(resource.data) ||
        isRoutineTrainer(request.resource.data)
      );
      allow delete: if isSignedIn() && (isAdmin() || isRoutineTrainer(resource.data));
    }

    match /users/{userId}/aiRoutineHistory/{historyId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          isOwner(userId) ||
          resource.data.ownerUid == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(userId)) &&
            get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid) ||
          (exists(/databases/$(database)/documents/users/$(userId)) &&
            get(/databases/$(database)/documents/users/$(userId)).data.email == request.auth.token.email)
        )
      );
      allow create, update, delete: if false;
    }

    // Catalogo de maquinas para mantenimiento
    match /catalogo_maquinas/{machineId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Reportes de mantenimiento generados por clientes
    match /reportes_mantenimiento/{reportId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.creadoPorUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.creadoPorUid == request.auth.uid &&
        request.resource.data.maquinaId is string &&
        request.resource.data.maquinaNombre is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /memberRoutines/{memberId} {
      allow read: if canReadRoutine(resource.data);
      allow create: if isSignedIn() && (isAdmin() || isRoutineTrainer(request.resource.data));
      allow update: if isSignedIn() && (
        isAdmin() ||
        isRoutineTrainer(resource.data) ||
        isRoutineTrainer(request.resource.data)
      );
      allow delete: if isSignedIn() && (isAdmin() || isRoutineTrainer(resource.data));
    }

    // Sesiones de entrenamiento agendadas por el entrenador
    match /entrenamientos/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Citas de nutricion agendadas
    match /citas/{citaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Notas privadas del entrenador
    match /trainerNotes/{noteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    function isValidDietFileTextField(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidDietFilePayload(data) {
      return isValidDietFileTextField(data, 'title', 120) &&
             isValidDietFileTextField(data, 'notes', 500);
    }

    // Archivos de dieta
    match /dietFiles/{fileId} {
      allow read: if isSignedIn() || isAdmin() || ownsMember(resource.data.memberId);
      allow create: if
        (isAdmin() || (isSignedIn() && request.resource.data.ownerUid == request.auth.uid)) &&
        isValidDietFilePayload(request.resource.data);
      allow update: if
        (isAdmin() ||
          (isSignedIn() &&
            (("ownerUid" in resource.data && resource.data.ownerUid == request.auth.uid) ||
             !("ownerUid" in resource.data)))) &&
        isValidDietFilePayload(request.resource.data);
      allow delete: if isAdmin() ||
        (isSignedIn() &&
          (("ownerUid" in resource.data && resource.data.ownerUid == request.auth.uid) ||
           !("ownerUid" in resource.data)));
    }

    // Asignaciones de nutriólogos a clientes
    match /client_nutritionist_assignments/{clientId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
    }

    // Asignaciones de entrenadores a clientes
    match /client_trainer_assignments/{clientId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == clientId || isAdmin());
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (request.auth.uid == assignmentId || request.auth.uid == resource.data.uid);
      allow write: if isAuthenticated() && (request.auth.uid == assignmentId || request.auth.uid == request.resource.data.uid);
    }

    // Chat y Mensajes
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (chatId.matches('.*' + request.auth.uid + '.*') || isAdmin());
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (chatId.matches('.*' + request.auth.uid + '.*') || isAdmin());
      }
    }

    // Reseñas de nutriólogos
    match /nutritionist_reviews/{reviewId} {
      allow read: if isAuthenticated(); // Todos los autenticados pueden leer reseñas
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.clientId; // Solo el cliente puede crear su reseña
      allow update: if isAuthenticated() && request.auth.uid == resource.data.clientId || isAdmin(); // Cliente propietario o admin pueden actualizar
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.clientId || isAdmin(); // Cliente o admin pueden eliminar
    }

    // Reseñas de entrenadores
    match /trainer_reviews/{reviewId} {
      allow read: if isAuthenticated(); // Todos los autenticados pueden leer reseñas
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.clientId; // Solo el cliente puede crear su reseña
      allow update: if isAuthenticated() && request.auth.uid == resource.data.clientId || isAdmin(); // Cliente propietario o admin pueden actualizar
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.clientId || isAdmin(); // Cliente o admin pueden eliminar
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (request.auth.uid == assignmentId || request.auth.uid == resource.data.uid);
      allow write: if isAuthenticated() && (request.auth.uid == assignmentId || request.auth.uid == request.resource.data.uid);
    }
    
    // Chat y Mensajes
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (chatId.matches('.*' + request.auth.uid + '.*') || isAdmin());
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (chatId.matches('.*' + request.auth.uid + '.*') || isAdmin());
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
